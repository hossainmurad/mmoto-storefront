# Medusa v2 backend. Leave empty to use the built-in fallback category tree.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Medusa Admin > Settings > Publishable API Keys (must be linked to your sales channel)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Optional: region used for prices and new carts. Default: first region in BDT, else the first region.
MEDUSA_REGION_ID=

# Shared secret for /api/revalidate (set the same value in your Medusa subscriber)
REVALIDATE_SECRET=change-me
